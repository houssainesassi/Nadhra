# Copy to .env.local (or set in Vercel). Read only on the server; never sent to the browser.
# At least one key is needed. Without any, the page says the service isn't configured.

# Google AI Studio key. A project WITHOUT billing can never be charged (it gets 429 errors instead).
GEMINI_API_KEY=
# OpenRouter key: last-resort fallback, free models only. Unreliable for images in our tests.
OPENROUTER_API_KEY=

# PRIVACY: camera images and recorded questions go to these services. On free tiers they may keep
# and use them under their own terms, and the page tells the user so. For real users, consider a
# paid tier whose terms exclude training.

# Tried in order. Free-tier capacity is per model, so a later one can help when the first is busy.
GEMINI_VISION_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
# Must be free: openrouter/free, or a model id ending in ":free".
OPENROUTER_VISION_MODEL=openrouter/free
# Your site's address, sent to OpenRouter as the referrer.
APP_URL=http://localhost:3000

# Questions that need current information (news, weather, prices) can use Google Search grounding.
# Grounding is NOT in the Gemini free tier (checked Nov 2026: "Not available" on the pricing page;
# every model answers HTTP 429). It needs a project with billing: 5,000 searches/month included,
# then $14 per 1,000. Without it, answers say they can't check live information.
# GEMINI_SEARCH_API_KEY: optional key from a BILLED project, used only for search calls (question
# text and what the picture analysis found, never the image). Camera frames keep GEMINI_API_KEY.
GEMINI_SEARCH_API_KEY=
GEMINI_SEARCH_ENABLED=true
# After a refused search, search isn't tried again for this long.
SEARCH_COOLDOWN_MS=1800000
# A model that answered "high demand" (503) or nothing before the timeout is skipped this long.
AI_OVERLOAD_COOLDOWN_MS=20000

VISION_TIMEOUT_MS=9000
VISION_TOTAL_BUDGET_MS=22000
VISION_RATE_LIMIT_PER_MIN=40
VISION_TRANSCRIBE_RATE_LIMIT_PER_MIN=20
AI_RATE_LIMIT_COOLDOWN_MS=60000

# Fallback voice when the browser has no Arabic voice: Microsoft Edge's online neural voices.
# No key, but an unofficial endpoint with no guarantee. Set EDGE_TTS_DISABLED=1 to turn it off.
EDGE_TTS_DISABLED=
# Female voices only (anything else is ignored): ar-TN-ReemNeural (Tunisian, default), ar-SA-ZariyahNeural.
EDGE_TTS_VOICE=ar-TN-ReemNeural
TTS_RATE_LIMIT_PER_MIN=30

# Live conversation ("Talk live"): microphone and camera stream from the browser straight to Gemini
# Live with a short-lived token from /api/live/token; the key above never leaves the server.
# Models tried in order. 3.1 Flash Live answered ~1.1 s after the user stopped talking in our tests.
GEMINI_LIVE_MODELS=gemini-3.1-flash-live-preview,gemini-3.8-live
# Female voices only: Sulafat (warm, default), Kore, Leda, Despina, Achernar, Zephyr.
GEMINI_LIVE_VOICE=Sulafat
# Silence (ms) that ends the user's turn. Lower answers sooner but can cut off people who pause.
GEMINI_LIVE_SILENCE_MS=500
# Optional: high or low. How readily a pause counts as the end of the user's turn.
GEMINI_LIVE_END_SENSITIVITY=
GEMINI_LIVE_DISABLED=
LIVE_TOKEN_RATE_LIMIT_PER_MIN=12

# --- API protection and cost control (src/lib/server/guard.ts) ---
# Signs the anonymous session cookie. Optional: without it a key derived from GEMINI_API_KEY is used.
SESSION_SECRET=
SESSIONS_PER_ADDRESS_PER_HOUR=30
# Daily budgets, per browser session and for the whole service (UTC day). Past them the API answers
# "quota-exhausted" and the page says so. The GLOBAL values are the hard daily ceiling.
DAILY_VISION_PER_SESSION=2000
DAILY_VISION_GLOBAL=10000
DAILY_TRANSCRIBE_PER_SESSION=400
DAILY_TRANSCRIBE_GLOBAL=2000
DAILY_TTS_PER_SESSION=4000
DAILY_TTS_GLOBAL=30000
DAILY_LIVE_PER_SESSION=150
DAILY_LIVE_GLOBAL=1000
# Web search is the only billed call (with a billed GEMINI_SEARCH_API_KEY): 150/day stays inside the
# 5,000 included searches a month.
DAILY_SEARCH_PER_SESSION=30
DAILY_SEARCH_GLOBAL=150
# Optional shared counters for serverless hosts (Upstash Redis REST). Without them, limits are per
# server instance. Upstash has a free tier, but it is an external account: decide before enabling.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# /api/health shows counters and usage only with "Authorization: Bearer <HEALTH_TOKEN>" (16+ chars).
HEALTH_TOKEN=
# Log every monitored event, not only warnings.
MONITOR_LOG_ALL=
